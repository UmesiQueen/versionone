# ---------------------------------------------------------------------------
# VersionOne — environment variables
# Copy this file to `.env.local` and fill in real values:
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------

# Deployment environment. Set to "staging" on any non-production deployment:
# this marks every page noindex/nofollow in metadata AND adds an
# X-Robots-Tag response header. Leave as "production" on the live site.
NEXT_PUBLIC_APP_ENV=development

# Canonical origin, no trailing slash. Feeds page metadata, canonical URLs,
# sitemap.xml, the LocalBusiness JSON-LD, and Open Graph image URLs.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Booking ----------------------------------------------------------------

# Calendly scheduling link opened from the consultation booking flow.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-account/your-event

# --- Email (Resend) ---------------------------------------------------------
# https://resend.com/api-keys

# Server-side API key. Secret — must not be NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address. Must belong to a domain verified in Resend,
# otherwise sends are rejected. Format: "Name <address@domain>" or a bare
# address.
RESEND_FROM_EMAIL=VersionOne <noreply@yourdomain.com>

# Internal inbox that receives new booking and contact form alerts.
INTERNAL_NOTIFY_EMAIL=team@yourdomain.com

# --- Bot protection (Cloudflare Turnstile) ----------------------------------
# https://dash.cloudflare.com/?to=/:account/turnstile
# Cloudflare publishes always-pass test keys for local development —
# see https://developers.cloudflare.com/turnstile/troubleshooting/testing/

# Public widget key, rendered in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000

# Server-side verification secret. Secret — must not be NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000
